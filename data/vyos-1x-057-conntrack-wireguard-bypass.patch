diff --git a/src/conf_mode/system_conntrack.py b/src/conf_mode/system_conntrack.py
index cf1e503c0..419ff4860 100644
--- a/src/conf_mode/system_conntrack.py
+++ b/src/conf_mode/system_conntrack.py
@@ -103,6 +103,22 @@ def get_config(config=None):
 
     conntrack['module_map'] = module_map
 
+    # WireGuard data packets are encrypted and never offloaded, so tracking
+    # the outer UDP flow only costs cycles (conntrack, helper and firewall
+    # chains on every packet of the serial tx/rx stage). Skip tracking for the
+    # configured listen ports unless disabled. Only packets addressed to this
+    # router (prerouting) and sent from the listen port (output) are matched,
+    # forwarded traffic using the same port numbers stays tracked.
+    conntrack['wireguard_ports'] = []
+    if 'disable_wireguard_bypass' not in conntrack:
+        wg = conf.get_config_dict(['interfaces', 'wireguard'], key_mangling=('-', '_'),
+                                  get_first_key=True, no_tag_node_value_mangle=True)
+        ports = set()
+        for ifname, ifconfig in wg.items():
+            if isinstance(ifconfig, dict) and 'disable' not in ifconfig and 'port' in ifconfig:
+                ports.add(int(ifconfig['port']))
+        conntrack['wireguard_ports'] = sorted(ports)
+
     if conf.exists(['service', 'conntrack-sync']):
         set_dependents('conntrack_sync', conf)
 
